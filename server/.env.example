# AuditMind 本地开发最小配置。
# 超时、锁、文件大小和索引名等高级配置使用 app/core/config.py 中的默认值。

# 本地前端与 Cookie
ENVIRONMENT=local
CORS_ALLOWED_ORIGINS=["http://localhost:5173"]
AUTH_COOKIE_SECURE=false
AUTH_REFRESH_COOKIE_PATH=/api/auth

# Docker Compose 基础设施
POSTGRES_USER=hyperweave
POSTGRES_PASSWORD=hyperweave123
POSTGRES_DB=audit_mind
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@127.0.0.1:5432/${POSTGRES_DB}
REDIS_PASSWORD=redis123
REDIS_URL=redis://default:${REDIS_PASSWORD}@127.0.0.1:6379/0
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
ELASTICSEARCH_URL=http://127.0.0.1:9200
ELASTICSEARCH_API_KEY=YourAuditMindApiKey

# 本地 CPU MinerU；云端和 GPU 配置见 README。
MINERU_PROVIDER=local
MINERU_BASE_URL=http://127.0.0.1:8000
MINERU_BACKEND=pipeline
MINERU_SERVER_URL=

# OpenAI 兼容文本模型
AI_BASE_URL=https://your-model-provider/v1
AI_API_KEY=YourModelApiKey
AI_MODEL=YourModelName

# 可选的法规检索精排模型；全部留空时跳过 Rerank。
AI_RERANK_PROVIDER=
AI_RERANK_URL=
AI_RERANK_API_KEY=
AI_RERANK_MODEL=
AI_RERANK_TIMEOUT_SECONDS=30
AI_RERANK_CANDIDATE_COUNT=30
AI_RERANK_TOP_N=10
AI_RERANK_OPTIONS={}

# 可选的多模态视觉模型；以下三项任一为空时关闭视觉补充。
AI_VISION_MODEL_BASE_URL=
AI_VISION_API_KEY=
AI_VISION_MODEL=
AI_VISION_MAX_IMAGE_SIZE=10485760

# Embedding 模型；维度必须与模型输出一致。
AI_EMBEDDING_BASE_URL=https://your-embedding-provider/v1
AI_EMBEDDING_API_KEY=YourEmbeddingApiKey
AI_EMBEDDING_MODEL=YourEmbeddingModel
AI_EMBEDDING_DIMENSIONS=1024

# 使用 `python -c "import secrets; print(secrets.token_urlsafe(48))"` 生成。
JWT_SECRET_KEY=CHANGE_ME

# 可选：启用 XXL-JOB 等内部调度器调用维护接口；留空时接口关闭。
# 启用时请使用至少 32 字符的随机值。
SCHEDULER_ACCESS_TOKEN=
