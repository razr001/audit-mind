# 运行环境标识，目前用于区分本地、测试和生产配置。
ENVIRONMENT=local

# 本地 FastAPI 在宿主机运行时写入 JSONL，Alloy 从 ./logs 采集。
# 生产环境若由 Docker/Kubernetes 直接采集 stdout，可设置为空字符串。
LOG_FILE_PATH=logs/auditmind.jsonl
# 单个日志文件最大 20MB，最多保留 5 个历史文件。
LOG_FILE_MAX_BYTES=20971520
LOG_FILE_BACKUP_COUNT=5

# 浏览器开发地址白名单，必须使用 JSON 数组；生产同源部署可设为空数组。
# 禁止使用 *，也不要包含 URL 路径。
CORS_ALLOWED_ORIGINS=["http://localhost:5173"]

# 公共健康探针的单依赖硬超时与短期合并缓存，单位为秒。
HEALTH_CHECK_TIMEOUT_SECONDS=2
HEALTH_CACHE_TTL_SECONDS=2

# PostgreSQL 异步连接串：用户名、密码、地址、端口和数据库名。
DATABASE_URL=postgresql+asyncpg://YourPgUsernaeme:YourPgPassword@localhost:5432/audit_mind

# Redis 连接串；最后的 /0 表示使用 0 号数据库。
REDIS_URL=redis://default:YourRedisPassword@127.0.0.1:6379/0
# Redis 用于分布式锁，建连和单次读写必须有超时，避免网络半开造成永久挂起。
REDIS_CONNECT_TIMEOUT_SECONDS=3
REDIS_SOCKET_TIMEOUT_SECONDS=5
# 连接池中的空闲连接每隔多少秒做一次健康检查。
REDIS_HEALTH_CHECK_INTERVAL_SECONDS=30
# Dramatiq 完整审计和法规流水线的最大执行时间，单位为秒。
# 默认 2 小时，必须至少比对应的 PIPELINE_WAIT_TIMEOUT 多 300 秒。
DRAMATIQ_AUDIT_PIPELINE_TIME_LIMIT_SECONDS=7200
DRAMATIQ_REGULATION_PIPELINE_TIME_LIMIT_SECONDS=7200

# MinIO 对象存储。ENDPOINT 不要带 http:// 或 https://。
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=YourMinioUsername
MINIO_SECRET_KEY=YourMinioPassword
# 文档、法规和解析图片共用这一个 Bucket，应用启动时自动创建。
MINIO_BUCKET=auditmind-documents
# MinIO 是否使用 HTTPS；生产环境启用 TLS 时改成 true。
MINIO_SECURE=false
# MinIO 建连和读取超时，单位为秒。
MINIO_CONNECT_TIMEOUT_SECONDS=5
MINIO_READ_TIMEOUT_SECONDS=120
# 健康探针使用独立、短时且不重试的 MinIO 网络超时。
MINIO_HEALTH_TIMEOUT_SECONDS=2

# local 调用自建 mineru-api；cloud 调用 mineru.net 精准解析 API。
MINERU_PROVIDER=local
# 本地 MinerU 配置；MINERU_PROVIDER=cloud 时不会使用。
MINERU_BASE_URL=http://127.0.0.1:8000
# 云端 MinerU 配置。Token 在 https://mineru.net/apiManage 创建。
MINERU_CLOUD_API_BASE_URL=https://mineru.net
MINERU_CLOUD_API_TOKEN=
MINERU_CLOUD_MODEL_VERSION=vlm
MINERU_CLOUD_LANGUAGE=ch
# 建连超时和短状态查询的总超时，单位为秒。
MINERU_CONNECT_TIMEOUT_SECONDS=10
MINERU_STATUS_TIMEOUT_SECONDS=30
# 大文件上传和结果读取不设统一总时限；连接连续多久没有收到响应才超时。
# 更高层的流水线等待时间和 Dramatiq 时限仍会限制任务的最长生命周期。
MINERU_STREAM_IDLE_TIMEOUT_SECONDS=120
# hybrid-http-client：本机 mineru-api 负责 pipeline，远程 GPU 服务负责 VLM。
# 使用 docker-compose.cpu.yml 时必须改成 pipeline。
MINERU_BACKEND=hybrid-http-client
# mineru-api 在 Docker 中，本地模型服务使用 host.docker.internal；
# 独立 GPU 机器则改为 http://<GPU机器内网IP>:30000。
# CPU pipeline 模式不需要模型服务，此项留空即可。
MINERU_SERVER_URL=http://host.docker.internal:30000
# high 会启用更完整的图片/图表分析，但速度和显存开销更高。
MINERU_EFFORT=high
# auto 自动判断文本解析或 OCR；也可以明确填写 txt 或 ocr。
MINERU_PARSE_METHOD=auto
# 是否启用 MinerU 的公式、表格和图片分析能力。
MINERU_FORMULA_ENABLE=true
MINERU_TABLE_ENABLE=true
MINERU_IMAGE_ANALYSIS=true
# MinerU 结果安全限制，单位均为字节：压缩包 500MB、解压后 1GB、单图 20MB。
MINERU_MAX_RESULT_ARCHIVE_SIZE=524288000
MINERU_MAX_RESULT_UNCOMPRESSED_SIZE=1073741824
MINERU_MAX_RESULT_IMAGE_SIZE=20971520
# 单次结果最多接受的图片数量。
MINERU_MAX_RESULT_IMAGES=1000
# 文档同步结果的 Redis 锁租约，单位为秒；处理期间会自动续租。
DOCUMENT_PARSE_SYNC_LOCK_TTL_SECONDS=300
# 没有 MinerU task_id 的文档 PARSING 状态超过该时间后允许重新接管。
DOCUMENT_PARSE_STALE_SECONDS=3600
# 法规解析、分块、索引、规则构建和删除统一使用这一把总锁。
REGULATION_PIPELINE_LOCK_TTL_SECONDS=300
# 全量规则索引维护允许持有全局维护锁的最长时间，默认 24 小时。
REGULATION_RULE_INDEX_MAINTENANCE_MAX_HOLD_SECONDS=86400
# 同一助手会话的并发锁与单轮回答最大执行时间。
ASSISTANT_CONVERSATION_LOCK_TTL_SECONDS=180
# 一轮法规问答包含护栏、改写、检索和回答等串行阶段，默认总超时 10 分钟。
ASSISTANT_TURN_TIMEOUT_SECONDS=600
ASSISTANT_AGENT_MAX_CONCURRENT_RUNS=8
# 等待 MinerU 时每隔多少秒查询一次任务状态。
REGULATION_PIPELINE_POLL_INTERVAL_SECONDS=2
# 单次后台任务最多等待 MinerU 一小时；超时后再次调用接口可继续。
REGULATION_PIPELINE_WAIT_TIMEOUT_SECONDS=3600
# XXL-Job 调用内部超时任务维护接口的独立 Token；为空时接口不可用。
SCHEDULER_ACCESS_TOKEN=
# 各阶段遗留在运行状态多久后可判定为超时（秒）。
REGULATION_PARSE_STALE_SECONDS=7200
REGULATION_CHUNK_STALE_SECONDS=1800
REGULATION_RULE_STALE_SECONDS=7200
# 用户文档和知识法规的上传上限，当前都是 100MB。
DOCUMENT_MAX_FILE_SIZE=104857600
REGULATION_MAX_FILE_SIZE=104857600
# 普通 JSON/Form 请求体默认上限（字节）；PDF 上传接口使用各自文件上限。
REQUEST_BODY_MAX_BYTES=10485760
# 直接录入的 Markdown/纯文本知识最大字符数（默认约 50 万字）
REGULATION_MAX_TEXT_LENGTH=500000
# Markdown/纯文本审计原文会在内存中解析，默认最多 5 MiB。
AUDIT_MARKDOWN_MAX_BYTES=5242880


# FastAPI 连接 Elasticsearch 使用的业务配置。
# 管理员密码和 Kibana 密码分别保存在 docker 下，不进入业务配置。
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_API_KEY=YourAuditMindApiKey
# 文档检索 Chunk 使用的 ES 索引名；修改后相当于使用一个新索引。
# Chunk 切分或 Mapping 不兼容变更时递增版本，避免继续查询旧索引数据。
ELASTICSEARCH_REGULATION_CHUNK_INDEX=auditmind-regulation-chunks-v2
# 审计直接检索的原子规则索引；Mapping 或 Embedding 变化时递增版本。
ELASTICSEARCH_REGULATION_RULE_INDEX=auditmind-regulation-rules-v1

# 文本大模型：法规抽取、知识处理和后续审核使用。
AI_BASE_URL=https://www.xxx.com
AI_API_KEY=sk-xxx
AI_MODEL=gpt-5.5
# 单次模型请求超时（秒）和失败重试次数。
AI_TIMEOUT_SECONDS=120
AI_MAX_RETRIES=2

# 法规助手安全分类模型。留空时逐项回退到上面的文本模型配置。
# 生产环境建议使用响应快、支持稳定 JSON 输出的独立模型。
AI_GUARD_BASE_URL=
AI_GUARD_API_KEY=
AI_GUARD_MODEL=
AI_GUARD_TIMEOUT_SECONDS=30
# 多轮问题改写模型；只生成检索语句，不直接回答用户。
# 留空时逐项回退到文本模型配置。
AI_QUERY_REWRITE_BASE_URL=
AI_QUERY_REWRITE_API_KEY=
AI_QUERY_REWRITE_MODEL=
AI_QUERY_REWRITE_TIMEOUT_SECONDS=60

# 可选的法规检索精排模型。全部留空时跳过 Rerank，继续使用 RRF 结果。
# 第一方百炼和第三方实现都通过 auditmind.rerankers entry point 注册。
# 使用百炼时填写 bailian；使用自定义插件时填写插件注册的 entry point 名称。
AI_RERANK_PROVIDER=
AI_RERANK_URL=
# 可选。公网供应商通常需要；本地无鉴权 Rerank 服务可以留空。
AI_RERANK_API_KEY=
AI_RERANK_MODEL=
AI_RERANK_TIMEOUT_SECONDS=30
# 启用 Rerank 后，混合检索先召回这些候选，再精排到接口传入的 topK。
AI_RERANK_CANDIDATE_COUNT=30
# Provider 最多返回多少条；不得超过候选数，且应覆盖问答接口允许的最大 topK。
AI_RERANK_TOP_N=10
# 供应商扩展参数，使用 JSON 对象；参数名称和默认值由对应 Provider 定义。
# 百炼会根据 URL 自动识别 dashscope/openai 协议；代理地址无法识别时可设置 api_mode。
# 示例：{"api_mode":"dashscope","max_document_characters":4000,"max_total_characters":60000}
AI_RERANK_OPTIONS={}

# 多模态视觉模型：只在 MinerU 没有提供图片描述时补充分析。
# 如果与文本模型使用同一服务商，可以填写相同的地址和密钥。
# 以下三项任意一项留空即关闭视觉补充，不影响 MinerU 主解析流程。
AI_VISION_MODEL_BASE_URL=
AI_VISION_API_KEY=
AI_VISION_MODEL=
# 发送给视觉模型的单张图片上限，当前为 10MB。
AI_VISION_MAX_IMAGE_SIZE=10485760

# Embedding 模型用于法规和用户文档的语义检索。
# DIMENSIONS 必须与模型真实输出维度一致，否则 ES 无法写入向量。
AI_EMBEDDING_BASE_URL=https://your-embedding-provider/v1
AI_EMBEDDING_API_KEY=YourEmbeddingApiKey
AI_EMBEDDING_MODEL=YourEmbeddingModel
AI_EMBEDDING_DIMENSIONS=1024
AI_EMBEDDING_BATCH_SIZE=32
# 向量索引任务超过该秒数仍未结束时，允许新请求重新抢占。
REGULATION_INDEX_STALE_SECONDS=3600
# JWT 签名与校验配置。生产环境必须使用足够长的随机 SECRET_KEY。
# Deliberately invalid sentinel: generate a random value of at least 32 characters.
JWT_SECRET_KEY=CHANGE_ME
JWT_ALGORITHM=HS256
# ISSUER 和 AUDIENCE 必须与签发 Token 时保持一致。
JWT_ISSUER=audit-mind
JWT_AUDIENCE=audit-mind-api
# Token 有效期，单位为分钟。
JWT_EXPIRATION_DELTA=30
# Refresh Token 有效天数；仅通过 HttpOnly Cookie 传输。
JWT_REFRESH_EXPIRATION_DAYS=7
AUTH_REFRESH_COOKIE_NAME=auditmind-refresh-token
# 本地 HTTP 调试设为 false；经 HTTPS/Nginx 对外提供服务时必须设为 true。
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

# 审核任务超过该秒数仍为 RUNNING 时，允许重新领取以恢复进程中断。
AUDIT_TASK_STALE_SECONDS=3600
# 审计流水线 Redis 自动续租锁、MinerU 轮询间隔和单轮最长等待时间。
AUDIT_PIPELINE_LOCK_TTL_SECONDS=300
AUDIT_PIPELINE_POLL_INTERVAL_SECONDS=2
AUDIT_PIPELINE_WAIT_TIMEOUT_SECONDS=3600
# 单页 LLM 审计超过该时间仍在运行时，由维护接口标记为失败。
AUDIT_PAGE_STALE_SECONDS=600
